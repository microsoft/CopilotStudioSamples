{
  "name": "copilot-studio-whatsapp-relay",
  "version": "0.1.0",
  "private": true,
  "description": "An in-memory WhatsApp relay for authenticated Copilot Studio GHCP-harness agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.17.0 <23 || >=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js test/*.test.mjs",
    "start": "node --env-file=.env dist/src/index.js",
    "start:azure": "node dist/src/index.js",
    "start:local": "node -- scripts/local.mjs",
    "setup:auth": "node -- scripts/auth.mjs",
    "deploy:azure": "node -- scripts/deploy.mjs"
  },
  "dependencies": {
    "@microsoft/agents-activity": "1.9.1",
    "@microsoft/agents-copilotstudio-client": "1.9.1",
    "@microsoft/agents-hosting": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "cross-spawn": "7.0.6",
    "fflate": "0.8.2",
    "typescript": "5.9.3"
  }
}
