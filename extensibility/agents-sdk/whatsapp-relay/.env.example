# Copy to .env locally. Never commit the filled file.
PORT=3978
# Keep loopback for local use. The Azure deployment sets this to 0.0.0.0.
RELAY_HOST=127.0.0.1
META_GRAPH_VERSION=v25.0
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# Existing Azure Bot registration and its delegated Power Platform OAuth connection.
# This client secret authenticates the BOT to the token service, not the WhatsApp user.
BOT_CLIENT_ID=
BOT_TENANT_ID=
BOT_CLIENT_SECRET=
BOT_OAUTH_CONNECTION=mcs

# Temporary GHCP-harness bot base URL, including the explicit API version.
# Do not append /conversations. No default endpoint or standard-agent fallback.
GHCP_DIRECT_CONNECT_URL=https://<environment-host>/copilotstudio/agenticruntime/3p/dataverse-backed/authenticated/bots/<schema>?api-version=1
GHCP_CLOUD=Prod

# Optional exact HTTPS origins for agent-returned public/signed file URLs.
# Empty means inline data-URL attachments only. No bearer token is forwarded to these URLs.
GHCP_FILE_ORIGINS=
