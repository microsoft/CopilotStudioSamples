# Required
TYPESAFE_API_KEY=

# Pin a model version so tuned thresholds keep their meaning (see "Thresholds" in the README)
TYPESAFE_MODEL=jev-1.13.0

# Optional: Azure AI Search. Without these, the server searches the bundled demo corpus.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=procedures
# Optional: name of a semantic configuration on the index
AZURE_SEARCH_SEMANTIC_CONFIG=

# Optional: protect the MCP endpoint with an API key (Copilot Studio: Authentication > API key, header)
MCP_API_KEY=

PORT=3000
