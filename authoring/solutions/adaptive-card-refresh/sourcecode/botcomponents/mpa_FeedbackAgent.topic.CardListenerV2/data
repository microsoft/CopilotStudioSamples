kind: AdaptiveDialog
beginDialog:
  kind: OnActivity
  id: main
  priority: 0
  type: Invoke
  actions:
    - kind: SendActivity
      id: sendActivity_4gh1Cv
      activity: "Debug (remove for production) - invoke payload received: {System.Activity.Value}"

    - kind: ParseValue
      id: 3TJax1
      variable: Topic.resultData
      valueType:
        kind: Record
        properties:
          action:
            type:
              kind: Record
              properties:
                data:
                  type:
                    kind: Record
                    properties:
                      userResponse: String

                id: String
                title: String
                tooltip: String
                type: String
                verb: String

          trigger: String

      value: =System.Activity.Value

    - kind: SetTextVariable
      id: setVariable_wmAYA6
      variable: Topic.rawData
      value: "{System.Activity}"

    - kind: ConditionGroup
      id: conditionGroup_5IesVe
      conditions:
        - id: conditionItem_TCfNNv
          condition: =Topic.resultData.action.verb = "feedbackSubmitForm"
          actions:
            - kind: SendActivity
              id: sendActivity_PknjwL
              activity:
                kind: Activity
                value: |-
                  ={
                    status: 200,
                    body: {
                      statusCode: 200,
                      type: "application/vnd.microsoft.card.adaptive",
                      value: {
                        type: "AdaptiveCard",
                        body: [
                          {
                            type: "ColumnSet",
                            columns: [
                              {
                                type: "Column",
                                items: [
                                  {
                                    type: "Image",
                                    url: "data:image/png;base64,",
                                    altText: "Success Icon",
                                    size: "Small"
                                  }
                                ],
                                width: "auto"
                              },
                              {
                                type: "Column",
                                items: [
                                  {
                                    type: "TextBlock",
                                    weight: "Bolder",
                                    text: "Submitted",
                                    wrap: true
                                  },
                                  {
                                    type: "TextBlock",
                                    spacing: "None",
                                    text: "Submitted on "&Text(Now(),DateTimeFormat.ShortDateTime24),
                                    isSubtle: true,
                                    wrap: true
                                  }
                                ],
                                width: "stretch"
                              }
                            ]
                          },
                          {
                            type: "TextBlock",
                            text: "Thank you for sharing your feedback.",
                            wrap: true
                          }
                        ],
                        '$schema': "http://adaptivecards.io/schemas/adaptive-card.json",
                        version: "1.5"
                      }
                    }
                  }
                activityType: InvokeResponse
                name: RespondToFeedbackSubmitForm

        - id: conditionItem_DYxLGK
          condition: =Topic.resultData.action.verb = "feedbackSkipForm"
          actions:
            - kind: SendActivity
              id: sendActivity_m6AcR0
              activity:
                kind: Activity
                value: |-
                  ={
                    status: 200,
                    body: {
                      statusCode: 200,
                      type: "application/vnd.microsoft.card.adaptive",
                      value: {
                        type: "AdaptiveCard",
                        body: [
                          {
                            type: "ColumnSet",
                            columns: [
                              {
                                type: "Column",
                                items: [
                                  {
                                    type: "Image",
                                    url: "data:image/png;base64,",
                                    altText: "Success Icon",
                                    size: "Small"
                                  }
                                ],
                                width: "auto"
                              },
                              {
                                type: "Column",
                                items: [
                                  {
                                    type: "TextBlock",
                                    weight: "Bolder",
                                    text: "Skipped",
                                    wrap: true
                                  },
                                  {
                                    type: "TextBlock",
                                    spacing: "None",
                                    text: "Updated on "&Text(Now(),DateTimeFormat.ShortDateTime24),
                                    isSubtle: true,
                                    wrap: true
                                  }
                                ],
                                width: "stretch"
                              }
                            ]
                          },
                          {
                            type: "TextBlock",
                            text: "You skipped this survey",
                            wrap: true
                          }
                        ],
                        '$schema': "http://adaptivecards.io/schemas/adaptive-card.json",
                        version: "1.5"
                      }
                    }
                  }
                activityType: InvokeResponse
                name: ResponseToSkippedSurvey

      elseActions:
        - kind: SendActivity
          id: sendActivity_4u6V7A
          activity:
            kind: Activity
            value: |-
              ={
                status: 200,
                body:
                {  
                 statusCode: 200,
                 type: "application/vnd.microsoft.card.adaptive",
                 value:
                 {    
                  type: "AdaptiveCard",
                  body:
                  [
                    {
                      type: "TextBlock",
                      text: "I dont understand: " & Topic.rawData,
                      wrap: true
                    }
                  ],    
                  version: "1.3"  
                  }
                }
              }
            activityType: InvokeResponse
            name: UnknownResponse